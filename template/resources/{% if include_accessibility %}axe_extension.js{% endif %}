// Browser Library extension for the accessibility checks with axe-core.
// axe-core is installed into the project with `npm install` (see package.json).
const fs = require("fs");
const path = require("path");

// Keyword "Run Axe": checks the current page and returns the violations.
async function runAxe(page) {
    const axe = require("axe-core");
    await page.evaluate(axe.source);
    const result = await page.evaluate(async () => await axe.run());
    return result.violations.map((v) => ({
        id: v.id,
        impact: v.impact,
        help: v.help,
        helpUrl: v.helpUrl,
        count: v.nodes.length,
        nodes: v.nodes.map((n) => n.target.join(" ")),
    }));
}

function esc(text) {
    return String(text).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
}

// Keyword "Create Axe Report": writes the violations as an HTML report to <output dir>/accessibility/
// and returns the path relative to the output dir (so that the Robot log can link to it).
async function createAxeReport(violations, address, outputDir) {
    const folder = path.join(outputDir, "accessibility");
    fs.mkdirSync(folder, { recursive: true });
    const file = address.replace(/^[a-z]+:\/\//i, "").replace(/[^a-z0-9]+/gi, "_").replace(/^_+|_+$/g, "") + ".html";
    const rows = violations.length
        ? violations
              .map(
                  (v) => `<tr class="${esc(v.impact)}"><td>${esc(v.impact)}</td><td><a href="${esc(v.helpUrl)}">${esc(v.help)}</a>` +
                      `<br><small>${esc(v.id)}</small></td><td>${v.count}</td>` +
                      `<td><code>${v.nodes.map(esc).join("<br>")}</code></td></tr>`,
              )
              .join("\n")
        : `<tr><td colspan="4">No violations found.</td></tr>`;
    const html = `<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><title>Accessibility: ${esc(address)}</title>
<style>body{font-family:sans-serif;margin:2rem}table{border-collapse:collapse;width:100%;}
td,th{border:1px solid #ccc;padding:.4rem;vertical-align:top;text-align:left}
.critical td:first-child{background:#f8c9c9}.serious td:first-child{background:#fbdcb5}
.moderate td:first-child{background:#fff3b0}.minor td:first-child{background:#e3f0ff}</style></head>
<body><h1>Accessibility</h1><p>Page: <a href="${esc(address)}">${esc(address)}</a><br>
Checked on ${new Date().toLocaleString()} with axe-core.<br><strong>${violations.length} kinds of violations found.</strong></p>
<table><tr><th>Impact</th><th>Problem</th><th>Count</th><th>Elements</th></tr>
${rows}
</table><p><small>Automated checks find only part of the problems; they do not replace a manual review.</small></p></body></html>`;
    fs.writeFileSync(path.join(folder, file), html, "utf-8");
    return "accessibility/" + file;
}

exports.__esModule = true;
exports.runAxe = runAxe;
exports.createAxeReport = createAxeReport;
